{
  "name": "hbbatchbeast",
  "productName": "HBBatchBeast",
  "version": "2.1.5",
  "description": "Batch convert video with HandBrake or FFmpeg: per-folder presets, filters, safe file handling and a live queue.",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "node scripts/start.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "handbrake",
    "ffmpeg",
    "batch",
    "video",
    "conversion",
    "electron"
  ],
  "author": {
    "name": "Blake Stacks",
    "email": "blakestacks@rocketmail.com"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
